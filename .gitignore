# ---------------------------------------------------------------------------
# Secrets. Nothing in this block may ever be committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*

# dbt writes credentials into profiles.yml when you run `dbt init`.
# This project keeps its own profiles.yml under dbt/ and reads every secret
# through env_var(), so the file below is only the interactive-init leftover.
.dbt/
profiles.yml
!dbt/profiles.yml

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---------------------------------------------------------------------------
# dbt build artefacts. Regenerated by `dbt run`; never source of truth.
# ---------------------------------------------------------------------------
dbt/target/
dbt/dbt_packages/
dbt/logs/

# ---------------------------------------------------------------------------
# Downloaded and derived data.
#
# Rule of thumb for this repo: if a file regenerates from a documented source
# by running a script, it does not belong in git. `data/` is the landing zone
# for everything fetched at runtime.
#
# Specifically excluded:
#   - APCIQ quarterly PDFs: licence forbids redistributing the data as such
#     (docs/data-sources.md section 2.2). ~200 MB for 29 quarters.
#   - MAMH roll extract: 52.5 MB, regenerates in 88 s from a CC-BY source
#     (docs/data-sources.md section 2.8).
# ---------------------------------------------------------------------------
data/
*.pdf
mamh_roll_*_island.csv

# sample_data/ IS committed on purpose: small, real extracts that let a reader
# check the Data Source Matrix without downloading anything. Guard against a
# large file landing there by accident.
sample_data/**/*.zip
sample_data/**/*.xml

# ---------------------------------------------------------------------------
# OS and editor noise
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
