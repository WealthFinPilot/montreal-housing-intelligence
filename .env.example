# ---------------------------------------------------------------------------
# Montreal Housing Intelligence -- environment template
#
# Copy this file to `.env` and fill in the blanks:
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed. This template carries no
# real value: every secret below is empty on purpose.
#
# Check before every commit:
#     bash scripts/check-secrets.sh
# ---------------------------------------------------------------------------

# --- Database credentials --------------------------------------------------
# Read by docker compose on the SERVER when it creates the container, and by
# the ingestion scripts and dbt on the LAPTOP when they connect to it.
POSTGRES_DB=mhi
POSTGRES_USER=mhi_app
# Generate a long random password, for example:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Where the container publishes the database, ON THE SERVER --------------
# Used by docker-compose.yml only.
#
# 127.0.0.1 is the entire security model of this project: the database listens
# on the server loopback and is unreachable from the internet, even though the
# host has no firewall. Changing this to 0.0.0.0 would expose it directly.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Where a CLIENT dials the database, FROM THE LAPTOP ---------------------
# Used by the ingestion scripts and by dbt. Deliberately separate from the two
# lines above: "which port does the container publish on the server" and "which
# port does a client dial here" are two different questions, and conflating
# them breaks the moment either side moves.
#
# 15432 is the local end of the SSH tunnel opened by scripts/tunnel-start.sh.
# Leave both commented out to accept these defaults.
#MHI_DB_HOST=127.0.0.1
#MHI_DB_PORT=15432

# --- Server access ----------------------------------------------------------
# Used only to open the SSH tunnel. Never hard-coded anywhere in the repo.
VPS_HOST=
VPS_USER=root
# A key dedicated to this project, not your general-purpose key: it can be
# revoked on its own. A leading ~/ is expanded by the scripts.
VPS_SSH_KEY=~/.ssh/id_ed25519_mhi_vps
