# ---------------------------------------------------------------------------
# Montreal Housing Intelligence -- environment template
#
# Copy this file to `.env` and fill in the blanks:
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed. This template carries no
# real value: every secret below is empty on purpose.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Read by docker compose on the server (POSTGRES_* are the official variables
# of the postgres image) AND by the ingestion scripts and dbt on the laptop.
POSTGRES_DB=mhi
POSTGRES_USER=mhi_app
# Generate a long random password, for example:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Where the client reaches the database.
# On the laptop this stays 127.0.0.1: the database is NOT exposed to the
# internet, you reach it through the SSH tunnel described in the README.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Server ---------------------------------------------------------------
# Used only to open the SSH tunnel. Never hard-coded anywhere in the repo.
VPS_HOST=
VPS_USER=root
VPS_SSH_KEY=~/.ssh/id_ed25519_mhi_vps
